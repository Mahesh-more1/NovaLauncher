<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_app_drawer.xml
    Full-screen frosted bottom sheet layout for the NovaLauncher App Drawer.
    Includes:
      - Swipe/drag indicator handle
      - Search bar with clear and voice action buttons
      - 4-column RecyclerView for all installed apps
      - Fast-scroll alphabet index (A-Z) on the right edge
      - Empty search results state
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_drawer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frosted_dark_heavy"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <!-- Top drag handle pill -->
    <View
        android:id="@+id/drawer_drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_resize_handle"
        android:alpha="0.6" />

    <!-- Top Search Header -->
    <androidx.cardview.widget.CardView
        android:id="@+id/search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/drawer_drag_handle"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/search_bar_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/iv_search_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="@color/search_hint_color"
                android:contentDescription="@string/search_hint" />

            <EditText
                android:id="@+id/search_edit_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textColor="@color/search_text_color"
                android:textColorHint="@color/search_hint_color"
                android:textSize="15sp"
                android:imeOptions="actionSearch"
                android:inputType="textFilter|textNoSuggestions"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="2dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/search_hint_color"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/cancel" />

            <ImageView
                android:id="@+id/btn_voice_search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="6dp"
                android:padding="2dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="@color/search_hint_color"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_hint" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Main Content Layout (Grid + Side Alphabet) -->
    <RelativeLayout
        android:id="@+id/drawer_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/search_bar_container">

        <!-- 4-column App Grid RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawer_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/alphabet_index_layout"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="48dp"
            android:scrollbars="none" />

        <!-- Vertical Alphabet Fast-Scroll Index -->
        <LinearLayout
            android:id="@+id/alphabet_index_layout"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- Empty search results placeholder -->
        <TextView
            android:id="@+id/empty_search_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="No apps found"
            android:textColor="@color/search_hint_color"
            android:textSize="16sp"
            android:visibility="gone" />

    </RelativeLayout>

</RelativeLayout>
