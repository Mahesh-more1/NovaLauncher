<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_app_options.xml
    Bottom sheet dialog displayed when long-pressing an app icon.
    Options:
      - Open app
      - Add to Dock
      - Add Widget
      - App Info
      - Uninstall
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialog_app_options_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/frosted_dark_heavy"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top drag handle -->
    <View
        android:id="@+id/options_drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/widget_resize_handle"
        android:alpha="0.5" />

    <!-- App Header: 64dp Icon + App Title & Package Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/dialog_app_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="fitCenter"
            android:elevation="4dp"
            android:contentDescription="@string/app_icon_desc"
            tools:src="@android:drawable/sym_def_app_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialog_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/search_text_color"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="App Name" />

            <TextView
                android:id="@+id/dialog_app_package"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/search_hint_color"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="com.example.app" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dock_divider"
        android:layout_marginBottom="8dp" />

    <!-- Option 1: Open -->
    <LinearLayout
        android:id="@+id/option_open"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/search_text_color"
            android:contentDescription="@string/launch_app" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/launch_app"
            android:textColor="@color/search_text_color"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Option 2: Add to Dock -->
    <LinearLayout
        android:id="@+id/option_add_to_dock"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_add"
            android:tint="@color/search_text_color"
            android:contentDescription="@string/pin_to_dock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/pin_to_dock"
            android:textColor="@color/search_text_color"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Option 3: Add Widget -->
    <LinearLayout
        android:id="@+id/option_add_widget"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="@color/search_text_color"
            android:contentDescription="@string/add_widget" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/add_widget"
            android:textColor="@color/search_text_color"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Option 4: App Info -->
    <LinearLayout
        android:id="@+id/option_app_info"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:tint="@color/search_text_color"
            android:contentDescription="@string/app_info" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/app_info"
            android:textColor="@color/search_text_color"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Option 5: Uninstall -->
    <LinearLayout
        android:id="@+id/option_uninstall"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/ios_red"
            android:contentDescription="@string/uninstall_app" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/uninstall_app"
            android:textColor="@color/ios_red"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
