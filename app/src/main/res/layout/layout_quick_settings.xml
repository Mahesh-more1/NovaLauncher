<?xml version="1.0" encoding="utf-8"?>
<!--
    layout_quick_settings.xml
    Full-width iOS-style Control Center / Quick Settings overlay panel.
    Features:
      - Large digital time and date header
      - Interactive Brightness and Volume sliders
      - 2x4 grid of Quick Settings tiles (WiFi, Bluetooth, Airplane, Flashlight, Rotate, DND, Battery, Settings)
      - Each tile: 24dp icon + 10sp label + tinted rounded CardView state
      - Bottom safe area padding
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/qs_root_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qs_panel_bg"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="48dp">

            <!-- iOS Style Header: Time and Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/qs_header_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:41"
                    android:textColor="@color/clock_time_color"
                    android:textSize="54sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/qs_header_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Thursday, November 12"
                    android:textColor="@color/clock_date_color"
                    android:textSize="15sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Media / Sliders Section (Brightness & Volume) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"
                android:baselineAligned="false">

                <!-- Brightness Slider Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_brightness"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/qs_tile_bg_inactive">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/iv_brightness_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_menu_day"
                            android:tint="@color/qs_tile_icon_inactive"
                            android:contentDescription="Brightness" />

                        <SeekBar
                            android:id="@+id/slider_brightness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="255"
                            android:progress="180"
                            android:progressTint="@color/qs_slider_fill"
                            android:thumbTint="@color/qs_slider_fill" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Volume Slider Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_volume"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/qs_tile_bg_inactive">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/iv_volume_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_lock_silent_mode_off"
                            android:tint="@color/qs_tile_icon_inactive"
                            android:contentDescription="Volume" />

                        <SeekBar
                            android:id="@+id/slider_volume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="70"
                            android:progressTint="@color/qs_slider_fill"
                            android:thumbTint="@color/qs_slider_fill" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- 2x4 Quick Settings Grid -->
            <!-- Row 1: Wi-Fi, Bluetooth, Airplane, Flashlight -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:baselineAligned="false">

                <!-- Tile 1: Wi-Fi -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/tile_wifi"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/qs_tile_bg_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/tile_wifi_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/presence_online"
                            android:tint="@color/ios_blue"
                            android:contentDescription="@string/toggle_wifi" />

                        <TextView
                            android:id="@+id/tile_wifi_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/toggle_wifi"
                            android:textColor="@color/qs_tile_icon_active"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tile 2: Bluetooth -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/tile_bluetooth"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/qs_tile_bg_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/tile_bluetooth_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/stat_sys_data_bluetooth"
                            android:tint="@color/qs_tile_icon_inactive"
                            android:contentDescription="@string/toggle_bluetooth" />

                        <TextView
                            android:id="@+id/tile_bluetooth_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/toggle_bluetooth"
                            android:textColor="@color/qs_tile_label"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tile 3: Airplane Mode -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/tile_airplane"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/qs_tile_bg_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/tile_airplane_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_send"
                            android:tint="@color/qs_tile_icon_inactive"
                            android:contentDescription="@string/toggle_airplane" />

                        <TextView
                            android:id="@+id/tile_airplane_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/toggle_airplane"
                            android:textColor="@color/qs_tile_label"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tile 4: Flashlight -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/tile_flashlight"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/qs_tile_bg_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/tile_flashlight_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_compass"
                            android:tint="@color/qs_tile_icon_inactive"
                            android:contentDescription="@string/toggle_flashlight" />

                        <TextView
                            android:id="@+id/tile_flashlight_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/toggle_flashlight"
                            android:textColor="@color/qs_tile_label"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Row 2: Auto-Rotate, DND, Battery Saver, Settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:baselineAligned="false">

                <!-- Tile 5: Auto Rotate -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/tile_rotation"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/qs_tile_bg_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/tile_rotation_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_rotate"
                            android:tint="@color/ios_blue"
                            android:contentDescription="@string/toggle_rotation" />

                        <TextView
                            android:id="@+id/tile_rotation_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/toggle_rotation"
                            android:textColor="@color/qs_tile_icon_active"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tile 6: Do Not Disturb -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/tile_dnd"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/qs_tile_bg_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/tile_dnd_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_lock_idle_alarm"
                            android:tint="@color/qs_tile_icon_inactive"
                            android:contentDescription="@string/toggle_dnd" />

                        <TextView
                            android:id="@+id/tile_dnd_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/toggle_dnd"
                            android:textColor="@color/qs_tile_label"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tile 7: Battery Saver -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/tile_battery"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/qs_tile_bg_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/tile_battery_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_lock_idle_charging"
                            android:tint="@color/qs_tile_icon_inactive"
                            android:contentDescription="@string/toggle_battery_saver" />

                        <TextView
                            android:id="@+id/tile_battery_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/toggle_battery_saver"
                            android:textColor="@color/qs_tile_label"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tile 8: Launcher Settings -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/tile_settings"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/qs_tile_bg_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/tile_settings_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_preferences"
                            android:tint="@color/qs_tile_icon_inactive"
                            android:contentDescription="Settings" />

                        <TextView
                            android:id="@+id/tile_settings_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Settings"
                            android:textColor="@color/qs_tile_label"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Bottom safe padding view -->
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
